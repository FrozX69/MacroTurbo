<Window x:Class="MacroTurbo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MacroTurbo" 
        Height="400" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Grid.Row="0" 
                   Text="MacroTurbo - Auto-Clicker" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Section Macro -->
        <GroupBox Grid.Row="1" Header="Macro - Auto-Clicker (E)" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Intervalle (ms):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" 
                             Width="80" VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>
                <Button Content="{Binding IsRunning, StringFormat='ARRÊTER', Converter={StaticResource EmptyConverter}}"
                        Command="{Binding ToggleMacroCommand}" 
                        Height="35" 
                        FontSize="12" 
                        FontWeight="Bold"
                        Background="Green"
                        Foreground="White"/>
                <TextBlock Text="État: ARRÊT" Foreground="Green" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Section Anti-AFK -->
        <GroupBox Grid.Row="2" Header="Anti-AFK (Scroll 50s)" Padding="15" Margin="0,0,0,10">
            <Button Content="DÉMARRER Anti-AFK"
                    Command="{Binding ToggleAntiAfkCommand}" 
                    Height="35" 
                    FontSize="12" 
                    FontWeight="Bold"
                    Background="DodgerBlue"
                    Foreground="White"/>
        </GroupBox>

        <!-- Infos -->
        <TextBlock Grid.Row="3" 
                   Text="F8 = Toggle Macro (appuyer sur E) | Scroll key = Anti-AFK" 
                   Foreground="Gray" 
                   FontStyle="Italic"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Espace vide -->
        <TextBlock Grid.Row="5"/>
    </Grid>
</Window>
